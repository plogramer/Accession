@inherits ObservingComponentBase
@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS

@* Root component of the web page: theme, current screen, notifications, busy overlay and dialogs. *@
<CascadingValue Value="Model" IsFixed="true">
    <div class="app" data-theme="@ThemeAttribute">
        @switch (Model.Screen)
        {
            case IShellModel shell:
                <AppShell Model="shell" />
                break;
            case IStartModel start:
                <StartPage Model="start" />
                break;
        }

        <ToastHost Service="Model.Toasts" />

        @if (Model.IsBusy)
        {
            <div class="overlay">
                <div class="overlay-card" role="status">
                    <div class="spinner"></div>
                    <div class="overlay-text">@Model.BusyMessage</div>
                    @if (Model.CanCancelBusy)
                    {
                        <button class="btn" @onclick="() => Run(Model.CancelBusyCommand)">Cancel</button>
                    }
                </div>
            </div>
        }

        <DialogHost Center="Model.Dialogs" />

        @if (_helpOpen)
        {
            <Modal IsOpen="true" Title="Keyboard shortcuts" Width="480px" OnClose="() => _helpOpen = false">
                <table class="shortcuts">
                    @foreach (var (keys, action) in Shortcuts.Help)
                    {
                        <tr><td>@foreach (var key in keys.Split(' ')) { <kbd>@key</kbd> }</td><td>@action</td></tr>
                    }
                </table>
            </Modal>
        }
    </div>
</CascadingValue>

@code {
    private DotNetObjectReference<AppRoot>? _self;
    private bool _helpOpen;

    [Parameter, EditorRequired] public IAppModel Model { get; set; } = default!;

    private string? ThemeAttribute => Model.Theme is "light" or "dark" ? Model.Theme : null;

    protected override void OnParametersSet() => Observe(Model);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Model.PageRendered();
            _self = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("accession.registerShortcuts", _self);
            }
            catch (JSException)
            {
                // accession.js did not load: the page works without keyboard shortcuts
            }
        }
    }

    /// <summary>Called by accession.js for the page's keyboard shortcuts.</summary>
    [JSInvokable]
    public async Task OnShortcut(string key)
    {
        if (await Shortcuts.HandleAsync(Model, key))
        {
            _helpOpen = !_helpOpen;
        }

        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        Dispose(); // stop observing (the renderer calls only DisposeAsync when both exist)
        if (_self is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("accession.unregisterShortcuts");
            }
            catch (JSDisconnectedException)
            {
                // the page is already gone
            }

            _self.Dispose();
        }
    }
}
