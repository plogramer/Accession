@inherits ObservingComponentBase
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="page page-wide page-fill page-files">
    <div class="page-header">
        <div>
            <h2>Files</h2>
            <p class="muted">@(string.IsNullOrEmpty(Model.TotalsText) ? "Every file in the inventory, with its SHA-1." : Model.TotalsText)</p>
        </div>
        <div class="page-actions">
            <button class="btn" title="Export the files this screen shows to Excel" disabled="@Disabled(Model.ExportViewCommand)" @onclick="() => Run(Model.ExportViewCommand)"><Icon Name="download" Size="16" /> Export current view</button>
            <button class="icon-btn icon-btn-lg" title="Refresh" @onclick="() => Run(Model.RefreshCommand)"><Icon Name="refresh" Class="@(Model.IsLoading ? "spin" : null)" /></button>
            <HelpButton Topic="@HelpTopics.Files" />
        </div>
    </div>

    <SplitPanel SideWidth="250px">
        <Side>
            <section class="card tree-card">
                <Tabs Items="SideTabs" ActiveKey="@Model.SideTab" ActiveKeyChanged="key => Model.SideTab = key" />
                @if (Model.SideTab == "saved")
                {
                    <div class="tree saved-list" role="listbox" aria-label="Saved searches">
                        @foreach (var saved in Model.SavedSearches)
                        {
                            var selected = saved.Id == Model.SelectedSavedSearch?.Id;
                            <div class="saved-row @(selected ? "is-selected" : null)" role="option" aria-selected="@(selected ? "true" : "false")"
                                 title="@saved.Tooltip" @onclick="() => Model.SelectedSavedSearch = saved">
                                <Icon Name="bookmark" Size="15" Class="tree-icon" />
                                <div class="saved-text">
                                    <span class="saved-name truncate">@saved.Name</span>
                                    <span class="muted small">@saved.Files · @saved.Size</span>
                                </div>
                                @if (Model.CanChangeSavedSearches)
                                {
                                    <div @onclick:stopPropagation="true">
                                        <Dropdown TriggerClass="icon-btn" Title="@($"Actions for {saved.Name}")" Floating="true">
                                            <Trigger><Icon Name="more" Size="15" /></Trigger>
                                            <ChildContent>
                                                <MenuItem Icon="edit" Text="Edit" Command="Model.EditSavedSearchCommand" CommandParameter="saved" />
                                                <MenuItem Icon="trash" Text="Delete" Command="Model.DeleteSavedSearchCommand" CommandParameter="saved" />
                                            </ChildContent>
                                        </Dropdown>
                                    </div>
                                }
                            </div>
                        }
                        @if (Model.SavedSearches.Count == 0)
                        {
                            <div class="saved-empty muted small">No saved searches yet. Filter the files, then use <strong>Add to saved search</strong>, or create one here.</div>
                        }
                    </div>
                    <div class="tree-footer">
                        <button class="btn btn-sm" disabled="@Disabled(Model.NewSavedSearchCommand)" @onclick="() => Run(Model.NewSavedSearchCommand)">
                            <Icon Name="plus" Size="14" /> New saved search
                        </button>
                    </div>
                }
                else
                {
                    <div class="tree" role="tree" @ref="_tree">
                        <div class="tree-row @(Model.SelectedFolder is null && Model.SelectedSavedSearch is null ? "is-selected" : null)" style="padding-left:6px"
                             @onclick="ShowAllMedia">
                            <span class="tree-toggle"></span>
                            <Icon Name="dashboard" Size="15" Class="tree-icon" />
                            <span class="tree-name">All media</span>
                        </div>
                        <FolderTree Nodes="Model.Folders" Model="Model" OnContextMenu="OpenFolderMenu" />
                    </div>
                    <label class="tree-footer check-row">
                        <input type="checkbox" checked="@Model.IncludeSubfolders" @onchange="e => SetAndApply(() => Model.IncludeSubfolders = e.Value is true)" />
                        Include subfolders
                    </label>
                }
            </section>
        </Side>
        <Main>
            <section class="card filter-card">
                <div class="filter-row" @onkeydown="OnFilterKey">
                    <div class="search search-wide">
                        <Icon Name="search" Size="15" />
                        <input type="search" data-shortcut-search placeholder="File name contains…" value="@Model.NameContains"
                               @oninput="e => Model.NameContains = e.Value?.ToString() ?? string.Empty" />
                    </div>
                    <input class="input input-ext" placeholder="Extension" title="Extension without the dot; (none) for files without one"
                           value="@Model.ExtensionText" @oninput="e => Model.ExtensionText = e.Value?.ToString() ?? string.Empty" />
                    <select class="input" title="Category" value="@Model.CategoryValue" @onchange="e => Model.CategoryValue = e.Value?.ToString() ?? string.Empty">
                        @foreach (var option in Model.CategoryOptions)
                        {
                            <option value="@option.Value">@option.Label</option>
                        }
                    </select>
                    <Dropdown CloseOnClick="false" IsMenu="false" Wide="true" Title="More filters">
                        <Trigger><Icon Name="filter" Size="15" /> More <Icon Name="chevron-down" Size="14" /></Trigger>
                        <ChildContent>
                            <div class="filter-panel" @onkeydown="OnFilterKey">
                                <div class="field">
                                    <label>Hash status</label>
                                    <select class="input" value="@Model.HashStatusValue" @onchange="e => Model.HashStatusValue = e.Value?.ToString() ?? string.Empty">
                                        @foreach (var option in Model.HashStatusOptions)
                                        {
                                            <option value="@option.Value">@option.Label</option>
                                        }
                                    </select>
                                </div>
                                <div class="field">
                                    <label>Size (@Model.SizeUnitLabel)</label>
                                    <div class="field-pair">
                                        <input class="input" placeholder="min" value="@Model.MinSizeText" @oninput="e => Model.MinSizeText = e.Value?.ToString() ?? string.Empty" />
                                        <span class="muted">to</span>
                                        <input class="input" placeholder="max" value="@Model.MaxSizeText" @oninput="e => Model.MaxSizeText = e.Value?.ToString() ?? string.Empty" />
                                    </div>
                                </div>
                                <div class="field">
                                    <label>Modified (UTC dates)</label>
                                    <div class="field-pair">
                                        <input class="input" type="date" value="@Model.ModifiedFromText" @onchange="e => Model.ModifiedFromText = e.Value?.ToString() ?? string.Empty" />
                                        <span class="muted">to</span>
                                        <input class="input" type="date" value="@Model.ModifiedToText" @onchange="e => Model.ModifiedToText = e.Value?.ToString() ?? string.Empty" />
                                    </div>
                                </div>
                                <div class="field">
                                    <label>SHA-1</label>
                                    <input class="input mono" placeholder="40 hex characters" value="@Model.Sha1Text" @oninput="e => Model.Sha1Text = e.Value?.ToString() ?? string.Empty" />
                                </div>
                                <label class="check-row"><input type="checkbox" checked="@Model.DuplicatesOnly" @onchange="e => Model.DuplicatesOnly = e.Value is true" /> Duplicates only</label>
                                <label class="check-row"><input type="checkbox" checked="@Model.ErrorsOnly" @onchange="e => Model.ErrorsOnly = e.Value is true" /> Files with errors only</label>
                            </div>
                        </ChildContent>
                    </Dropdown>
                    <button class="btn btn-primary" @onclick="() => Run(Model.ApplyCommand)">Apply</button>
                </div>
                @if (Model.ActiveFilters.Count > 0)
                {
                    <div class="chips-row">
                        <span class="muted small">Filtered by</span>
                        @foreach (var chip in Model.ActiveFilters)
                        {
                            <span class="chip chip-removable">
                                @chip.Label
                                <button class="chip-x" title="@($"Remove {chip.Label}")" aria-label="@($"Remove {chip.Label}")"
                                        @onclick="() => Run(Model.RemoveFilterCommand, chip.Key)"><Icon Name="x" Size="11" /></button>
                            </span>
                        }
                        <button class="link-btn" @onclick="() => Run(Model.ClearFiltersCommand)">Clear all</button>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.FilterError))
                {
                    <div class="field-error filter-error">@Model.FilterError</div>
                }
            </section>

            <section class="card files-card">
                <div class="card-header">
                    @if (Model.SelectedRow is { } row)
                    {
                        <div class="selection-bar">
                            <span class="strong truncate" title="@row.RelativePath">@row.Name</span>
                            <button class="btn btn-sm" disabled="@Disabled(Model.CopyPathCommand)" @onclick="() => Run(Model.CopyPathCommand)"><Icon Name="copy" Size="14" /> Copy path</button>
                            <button class="btn btn-sm" title="@row.Sha1" disabled="@Disabled(Model.CopySha1Command)" @onclick="() => Run(Model.CopySha1Command)"><Icon Name="copy" Size="14" /> Copy SHA-1</button>
                            <button class="btn btn-sm" disabled="@Disabled(Model.OpenContainingFolderCommand)" @onclick="() => Run(Model.OpenContainingFolderCommand)"><Icon Name="folder-open" Size="14" /> Show in folder</button>
                            <button class="btn btn-sm" disabled="@Disabled(Model.ShowCopiesCommand)" @onclick="() => Run(Model.ShowCopiesCommand)">
                                <Icon Name="files" Size="14" /> All copies@(row.Copies > 1 ? $" ({row.Copies:N0})" : null)
                            </button>
                        </div>
                    }
                    else
                    {
                        <h3>@(Model.IsLoading && Model.Rows.Count == 0 ? "Loading…" : "Select a file for actions")</h3>
                    }
                    <Dropdown TriggerClass="icon-btn icon-btn-lg" Title="Columns" CloseOnClick="false" IsMenu="false">
                        <Trigger><Icon Name="columns" /></Trigger>
                        <ChildContent>
                            <div class="menu-header"><span>Columns</span></div>
                            @foreach (var column in OptionalColumns)
                            {
                                <label class="check-row">
                                    <input type="checkbox" checked="@Model.VisibleColumns.Contains(column.Key)" @onchange="() => Model.ToggleColumn(column.Key)" />
                                    @column.Title
                                </label>
                            }
                        </ChildContent>
                    </Dropdown>
                </div>

                @* Saved searches: what is shown, ticked rows, and add / remove. *@
                <div class="bulk-bar">
                    @if (Model.SelectedSavedSearch is { } shown)
                    {
                        <span class="bulk-context" title="@shown.Description"><Icon Name="bookmark" Size="14" /> Saved search <strong>@shown.Name</strong></span>
                        @if (!string.IsNullOrEmpty(shown.Created))
                        {
                            <span class="muted small">@shown.Created</span>
                        }
                    }
                    @if (Model.CheckedFileIds.Count > 0)
                    {
                        <button class="chip chip-btn" title="Untick all" @onclick="() => Run(Model.ClearCheckedCommand)">
                            @Model.CheckedFileIds.Count.ToString("N0") ticked <Icon Name="x" Size="12" />
                        </button>
                    }
                    else if (Model.CanChangeSavedSearches)
                    {
                        <span class="muted small">Nothing ticked: Add to saved search and Copy use all results.</span>
                    }
                    <span class="card-header-spacer"></span>
                    @if (Model.SelectedSavedSearch is not null && Model.CanChangeSavedSearches)
                    {
                        @if (Model.CheckedFileIds.Count > 0)
                        {
                            <button class="btn btn-sm" disabled="@Disabled(Model.RemoveCheckedFromSavedSearchCommand)" @onclick="() => Run(Model.RemoveCheckedFromSavedSearchCommand)">Remove ticked</button>
                        }
                        <button class="btn btn-sm" disabled="@Disabled(Model.RemoveAllFromSavedSearchCommand)" @onclick="() => Run(Model.RemoveAllFromSavedSearchCommand)"
                                title="Remove every file shown (all pages) from this saved search">Remove all results</button>
                    }
                    @if (Model.CanChangeSavedSearches)
                    {
                        <Dropdown TriggerClass="btn btn-sm" Title="Add the ticked files, or all results, to a saved search" Wide="true">
                            <Trigger><Icon Name="bookmark" Size="14" /> Add to saved search <Icon Name="chevron-down" Size="13" /></Trigger>
                            <ChildContent>
                                @* Ticked files when any are ticked, otherwise all results (like Copy); the header says which. *@
                                <div class="menu-header"><span>@(Model.CheckedFileIds.Count > 0 ? $"Add {Model.CheckedFileIds.Count:N0} ticked files to" : $"Add all {Model.TotalCount:N0} results to")</span></div>
                                @foreach (var saved in Model.SavedSearches.Where(s => s.Id != Model.SelectedSavedSearch?.Id))
                                {
                                    <MenuItem Icon="bookmark" Text="@saved.Name" Command="Model.AddToSavedSearchCommand" CommandParameter="saved" />
                                }
                                <MenuItem Icon="plus" Text="New saved search…" Command="Model.AddToSavedSearchCommand" />
                            </ChildContent>
                        </Dropdown>
                    }
                    @if (Model.CanCopyFiles)
                    {
                        <Dropdown TriggerClass="btn btn-sm" Title="Copy the ticked files, or all results, to another folder" Wide="true">
                            <Trigger><Icon Name="copy" Size="14" /> Copy <Icon Name="chevron-down" Size="13" /></Trigger>
                            <ChildContent>
                                <div class="menu-header"><span>@(Model.CheckedFileIds.Count > 0 ? $"{Model.CheckedFileIds.Count:N0} ticked files" : $"All {Model.TotalCount:N0} results")</span></div>
                                <MenuItem Icon="download" Text="Generate copy batch…" Command="Model.GenerateCopyBatchCommand" />
                                <MenuItem Icon="copy" Text="Copy files…" Command="Model.CopyFilesCommand" />
                            </ChildContent>
                        </Dropdown>
                    }
                </div>

                <DataTable TItem="FileRow" Items="Model.Rows" Label="Files" Virtualize="true" Fill="true" Class="files-table"
                           SortKey="@Model.SortKey" SortDescending="Model.SortDescending" OnSort="Model.SortByAsync"
                           SelectedItem="Model.SelectedRow" SelectedItemChanged="row => Model.SelectedRow = row" OnRowContextMenu="OpenFileMenu"
                           IsLoading="Model.IsLoading" EmptyText="No files match these filters.">
                    <Columns>
                        <Column TItem="FileRow" Title="Tick" Order="-1" Class="check-cell">
                            <HeaderContent>
                                <input type="checkbox" title="Tick every file on this page" aria-label="Tick every file on this page"
                                       checked="@(Model.Rows.Count > 0 && Model.Rows.All(r => Model.CheckedFileIds.Contains(r.FileId)))"
                                       @onclick:stopPropagation="true" @onchange="e => Model.SetPageChecked(e.Value is true)" />
                            </HeaderContent>
                            <ChildContent>
                                <input type="checkbox" aria-label="@($"Tick {context.Name}")" checked="@Model.CheckedFileIds.Contains(context.FileId)"
                                       @onclick:stopPropagation="true" @onchange="e => Model.SetChecked(context, e.Value is true)" />
                            </ChildContent>
                        </Column>
                        @if (Show("media"))
                        {
                            <Column TItem="FileRow" Title="Media" Order="0" Class="mono">@context.MediaId</Column>
                        }
                        <Column TItem="FileRow" Title="Name" SortKey="name" Order="1" Class="name-cell">
                            <span title="@context.RelativePath">@context.Name</span>
                        </Column>
                        @if (Show("extension"))
                        {
                            <Column TItem="FileRow" Title="Ext" SortKey="extension" Order="2">
                                @if (context.Extension.Length > 0)
                                {
                                    <span class="ext">@context.Extension</span>
                                }
                            </Column>
                        }
                        @if (Show("folder"))
                        {
                            <Column TItem="FileRow" Title="Folder" SortKey="default" Order="3" Class="path-cell muted">
                                <span title="@context.FolderPath">@context.FolderPath</span>
                            </Column>
                        }
                        @if (Show("size"))
                        {
                            <Column TItem="FileRow" Title="Size" SortKey="size" Order="4" Class="num">@context.Size</Column>
                        }
                        @if (Show("modified"))
                        {
                            <Column TItem="FileRow" Title="Modified" SortKey="modified" Order="5" Class="muted">@context.Modified</Column>
                        }
                        @if (Show("created"))
                        {
                            <Column TItem="FileRow" Title="Created" Order="6" Class="muted">@context.Created</Column>
                        }
                        @if (Show("accessed"))
                        {
                            <Column TItem="FileRow" Title="Accessed" Order="7" Class="muted">@context.Accessed</Column>
                        }
                        @if (Show("category"))
                        {
                            <Column TItem="FileRow" Title="Category" Order="8" Class="muted">@context.Category</Column>
                        }
                        @if (Show("hash"))
                        {
                            <Column TItem="FileRow" Title="Hash" Order="9">
                                <span class="status @HashClass(context.HashStatus)">@context.HashStatus</span>
                            </Column>
                        }
                        @if (Show("sha1"))
                        {
                            <Column TItem="FileRow" Title="SHA-1" Order="10" Class="mono small">@context.Sha1</Column>
                        }
                        @if (Show("copies"))
                        {
                            <Column TItem="FileRow" Title="Copies" Order="11" Class="num">@(context.Copies > 1 ? context.Copies.ToString("N0") : null)</Column>
                        }
                    </Columns>
                </DataTable>

                <Pager PageIndex="Model.PageIndex" PageSize="Model.PageSize" PageSizes="Model.PageSizes" TotalCount="Model.TotalCount"
                       ItemName="files" IsBusy="Model.IsLoading" IsCounting="Model.IsCounting" HasMore="Model.Rows.Count == Model.PageSize"
                       RowsOnPage="Model.Rows.Count" OnPageChange="Model.GoToPageAsync" OnPageSizeChange="Model.SetPageSizeAsync" />
            </section>
        </Main>
    </SplitPanel>

    @* Right-click menus (the table's also open with the menu key or Shift+F10). *@
    <ContextMenu @ref="_fileMenu" Header="@Model.ContextHeader" Label="File actions">
        <MenuItem Icon="copy" Text="Copy SHA-1" Command="Model.CopyTargetSha1sCommand" />
        <MenuItem Icon="copy" Text="Copy path" Command="Model.CopyTargetPathsCommand" />
        <MenuItem Icon="copy" Text="Copy file name" Command="Model.CopyTargetNamesCommand" />
        <div class="menu-sep"></div>
        <MenuItem Icon="folder-open" Text="Show in folder" Command="Model.OpenContainingFolderCommand" />
        <MenuItem Icon="search" Text="Find all copies" Command="Model.ShowCopiesCommand" />
        <MenuItem Icon="filter" Text="Filter by this extension" Command="Model.FilterByExtensionCommand" />
        @if (Model.CanChangeSavedSearches)
        {
            <div class="menu-sep"></div>
            <div class="menu-header"><span>Add to saved search</span></div>
            <div class="menu-scroll">
                @foreach (var saved in Model.SavedSearches.Where(s => s.Id != Model.SelectedSavedSearch?.Id))
                {
                    <MenuItem Icon="bookmark" Text="@saved.Name" Command="Model.AddTargetsToSavedSearchCommand" CommandParameter="saved" />
                }
            </div>
            <MenuItem Icon="plus" Text="New saved search…" Command="Model.AddTargetsToSavedSearchCommand" />
        }
        @if (Model.CanCopyFiles)
        {
            <div class="menu-sep"></div>
            <MenuItem Icon="download" Text="Copy To…" Command="Model.CopyToCommand" />
        }
    </ContextMenu>
    <ContextMenu @ref="_folderMenu" Header="@Model.ContextFolderName" Label="Folder actions">
        <MenuItem Icon="folder-open" Text="Open in Explorer" Command="Model.OpenFolderInExplorerCommand" />
        <MenuItem Icon="copy" Text="Copy folder path" Command="Model.CopyFolderPathCommand" />
        <div class="menu-sep"></div>
        @if (Model.CanCopyFiles)
        {
            <MenuItem Icon="copy" Text="Copy this folder…" Command="Model.CopyFolderCommand" />
        }
        <MenuItem Icon="download" Text="Export this folder…" Command="Model.ExportFolderCommand" />
    </ContextMenu>
</div>

@code {
    /// <summary>Optional columns in display order (Name is always shown).</summary>
    public static readonly IReadOnlyList<(string Key, string Title)> OptionalColumns =
    [
        ("media", "Media"), ("extension", "Extension"), ("folder", "Folder"), ("size", "Size"), ("modified", "Modified"),
        ("created", "Created"), ("accessed", "Accessed"), ("category", "Category"), ("hash", "Hash status"),
        ("sha1", "SHA-1"), ("copies", "Copies"),
    ];

    private static readonly IReadOnlyList<TabItem> FolderTab = [new("folders", "Media"), new("saved", "Saved searches")];

    [Parameter, EditorRequired] public IFilesModel Model { get; set; } = default!;

    private IReadOnlyList<TabItem> SideTabs =>
        [FolderTab[0], new("saved", "Saved searches", Model.SavedSearches.Count > 0 ? Model.SavedSearches.Count.ToString("N0") : null)];

    private ElementReference _tree;
    private ContextMenu? _fileMenu;
    private ContextMenu? _folderMenu;

    private void OpenFileMenu(RowContextMenuArgs<FileRow> e)
    {
        _folderMenu?.Close();
        Model.OpenFileMenu(e.Item);
        StateHasChanged();
        _fileMenu?.Open(e.X, e.Y);
    }

    private void OpenFolderMenu(RowContextMenuArgs<FolderTreeNode> e)
    {
        _fileMenu?.Close();
        Model.OpenFolderMenu(e.Item);
        StateHasChanged();
        _folderMenu?.Open(e.X, e.Y);
    }
    private FolderTreeNode? _scrolledTo;

    private void ShowAllMedia() => Model.ShowAllMedia();

    /// <summary>A media chosen on another screen ("Browse files") may be far down the tree: bring it into view once.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Model.SideTab == "folders" && Model.SelectedFolder is { Depth: 0 } media && !ReferenceEquals(media, _scrolledTo))
        {
            _scrolledTo = media;
            await JS.InvokeVoidAsync("accession.scrollSelectedIntoView", _tree);
        }
    }

    protected override void OnParametersSet() => Observe(Model, Model.Folders, Model.SavedSearches, Model.CopyPathCommand, Model.CopySha1Command,
        Model.OpenContainingFolderCommand, Model.ShowCopiesCommand, Model.AddToSavedSearchCommand,
        Model.RemoveCheckedFromSavedSearchCommand, Model.RemoveAllFromSavedSearchCommand, Model.NewSavedSearchCommand,
        Model.AddTargetsToSavedSearchCommand, Model.CopyToCommand, Model.FilterByExtensionCommand);

    private bool Show(string key) => Model.VisibleColumns.Contains(key);

    private Task OnFilterKey(KeyboardEventArgs e) => e.Key == "Enter" ? Run(Model.ApplyCommand) : Task.CompletedTask;

    private Task SetAndApply(Action set)
    {
        set();
        return Run(Model.ApplyCommand);
    }

    private static string HashClass(string status) => status switch
    {
        "Hashed" => "is-success",
        "Error" => "is-danger",
        "Pending" => "is-active",
        _ => "is-neutral",
    };
}
