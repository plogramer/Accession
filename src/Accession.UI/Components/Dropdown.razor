@* Button that opens a floating panel (menu, filter list). Clicking outside closes it. *@
<div class="menu-anchor">
    <button class="@TriggerClass" title="@Title" aria-haspopup="@(IsMenu ? "menu" : "true")" aria-expanded="@(_open ? "true" : "false")"
            disabled="@Disabled" @onclick="Toggle">
        @Trigger
    </button>
    @if (_open)
    {
        <div class="backdrop" @onclick="Close"></div>
        <div class="menu @(Wide ? "menu-wide" : null) @(AlignLeft ? "menu-left" : null)" role="@(IsMenu ? "menu" : null)"
             @onclick="OnPanelClick">
            @ChildContent
        </div>
    }
</div>

@code {
    private bool _open;

    [Parameter, EditorRequired] public RenderFragment Trigger { get; set; } = default!;

    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    [Parameter] public string TriggerClass { get; set; } = "btn";

    [Parameter] public string? Title { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Close when anything inside the panel is clicked (menus); keep open for filter lists.</summary>
    [Parameter] public bool CloseOnClick { get; set; } = true;

    [Parameter] public bool IsMenu { get; set; } = true;

    [Parameter] public bool Wide { get; set; }

    [Parameter] public bool AlignLeft { get; set; }

    public void Close() => _open = false;

    private void Toggle() => _open = !_open;

    private void OnPanelClick()
    {
        if (CloseOnClick)
        {
            _open = false;
        }
    }
}
