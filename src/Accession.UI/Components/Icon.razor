@* Small inline SVG icon set (24×24, stroked with the current text colour). *@
<svg class="icon @Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "dashboard":
            <rect x="3" y="3" width="7" height="9" rx="1.5" /><rect x="14" y="3" width="7" height="5" rx="1.5" />
            <rect x="14" y="12" width="7" height="9" rx="1.5" /><rect x="3" y="16" width="7" height="5" rx="1.5" />
            break;
        case "media":
            <rect x="3" y="13" width="18" height="7" rx="2" /><path d="M5.5 13 8 5h8l2.5 8" /><path d="M7 16.5h.01M11 16.5h.01" />
            break;
        case "files":
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Z" />
            break;
        case "queue":
            <path d="M8 6h13M8 12h13M8 18h13" /><path d="M3.5 6h.01M3.5 12h.01M3.5 18h.01" />
            break;
        case "errors":
            <path d="M10.3 3.9 2.4 17.5A2 2 0 0 0 4.1 20.5h15.8a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" /><path d="M12 9v4M12 17h.01" />
            break;
        case "categories":
            <path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9Z" /><path d="M7.5 7.5h.01" />
            break;
        case "audit":
            <path d="M12 8v4l3 2" /><path d="M3.05 11a9 9 0 1 1 .5 4" /><path d="M3 5v6h6" />
            break;
        case "refresh":
            <path d="M21 12a9 9 0 0 1-15.5 6.2L3 16" /><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8" /><path d="M21 3v5h-5M3 21v-5h5" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
            break;
        case "play":
            <path d="M7 4.5v15l12-7.5Z" />
            break;
        case "pause":
            <path d="M8 5v14M16 5v14" />
            break;
        case "stop":
            <rect x="6" y="6" width="12" height="12" rx="1.5" />
            break;
        case "more":
            <path d="M5 12h.01M12 12h.01M19 12h.01" stroke-width="3" />
            break;
        case "sun":
            <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;
        case "moon":
            <path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11Z" />
            break;
        case "monitor":
            <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" />
            break;
        case "x":
            <path d="M18 6 6 18M6 6l12 12" />
            break;
        case "chevron-down":
            <path d="m6 9 6 6 6-6" />
            break;
        case "chevron-left":
            <path d="m15 6-6 6 6 6" />
            break;
        case "chevrons-left":
            <path d="m11 17-5-5 5-5M18 17l-5-5 5-5" />
            break;
        case "chevrons-right":
            <path d="m13 17 5-5-5-5M6 17l5-5-5-5" />
            break;
        case "arrow-up":
            <path d="M12 19V5M5 12l7-7 7 7" />
            break;
        case "arrow-down":
            <path d="M12 5v14M19 12l-7 7-7-7" />
            break;
        case "check":
            <path d="M20 6 9 17l-5-5" />
            break;
        case "chevron-right":
            <path d="m9 6 6 6-6 6" />
            break;
        case "filter":
            <path d="M3 5h18l-7 8.5V19l-4 2v-7.5Z" />
            break;
        case "external":
            <path d="M14 4h6v6M20 4l-9 9" /><path d="M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5" />
            break;
        case "lock":
            <rect x="4.5" y="10.5" width="15" height="10" rx="2" /><path d="M8 10.5V7a4 4 0 0 1 8 0v3.5" />
            break;
        case "eye":
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z" /><circle cx="12" cy="12" r="3" />
            break;
        case "offline":
            <path d="M2 8.8a15 15 0 0 1 4.2-2.6M9.5 5.2A15 15 0 0 1 22 8.8M5 12.5a10 10 0 0 1 3.6-2.2M15 10.5a10 10 0 0 1 4 2M8.5 16a5 5 0 0 1 7 0M12 20h.01M3 3l18 18" />
            break;
        case "folder-open":
            <path d="M3 18V6a2 2 0 0 1 2-2h4l2 2h7a2 2 0 0 1 2 2v2" /><path d="M3 18l2.6-6.5A2 2 0 0 1 7.5 10H21l-3 8Z" />
            break;
        case "settings":
            <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z" />
            break;
        case "logout":
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
            break;
        case "columns":
            <rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16M15 4v16" />
            break;
        case "bookmark":
            <path d="M6 4h12v16l-6-4-6 4Z" />
            break;
        case "edit":
            <path d="M4 20h4L18.5 9.5a2.1 2.1 0 0 0-3-3L5 17v3Z" /><path d="m14 8 2 2" />
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" />
            break;
        case "download":
            <path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" />
            break;
        case "copy":
            <rect x="8" y="8" width="13" height="13" rx="2" /><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3" />
            break;
        case "info":
            <circle cx="12" cy="12" r="9" /><path d="M12 16v-4M12 8h.01" />
            break;
        case "discover":
            <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5M11 8v6M8 11h6" />
            break;
        case "logo":
            <path d="M4 7.5 12 3l8 4.5v9L12 21l-8-4.5Z" /><path d="M4 7.5 12 12l8-4.5M12 12v9" />
            break;
        default:
            <circle cx="12" cy="12" r="2" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    [Parameter] public int Size { get; set; } = 18;

    [Parameter] public string? Class { get; set; }
}
