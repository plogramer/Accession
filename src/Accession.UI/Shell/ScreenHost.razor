@* Shows the page for a navigation item's model. Each screen gets its own error boundary. *@
<ScreenErrorBoundary @key="Item">
    @switch (Item.Content)
    {
        case IDashboardModel dashboard:
            <DashboardPage Model="dashboard" />
            break;
        case IMediaModel media:
            <MediaPage Model="media" />
            break;
        case IFilesModel files:
            <FilesPage Model="files" />
            break;
        case IScanQueueModel queue:
            <ScanQueuePage Model="queue" />
            break;
        case IErrorsModel errors:
            <ErrorsPage Model="errors" />
            break;
        case ICategoriesModel categories:
            <CategoriesPage Model="categories" />
            break;
        case IAuditModel audit:
            <AuditPage Model="audit" />
            break;
        default:
            <ClassicOnlyPage Title="@Item.Key" Icon="@Item.Icon" OpenCommand="OpenInClassicCommand" />
            break;
    }
</ScreenErrorBoundary>

@code {
    [Parameter, EditorRequired] public ShellNavItem Item { get; set; } = default!;

    [Parameter, EditorRequired] public ICommand OpenInClassicCommand { get; set; } = default!;
}
