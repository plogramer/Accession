<button class="menu-item" role="menuitem" title="@Title" disabled="@(!Enabled || !Command.CanExecute(CommandParameter))" @onclick="Execute">
    <Icon Name="@Icon" Size="16" />
    <span>@Text</span>
</button>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    [Parameter, EditorRequired] public ICommand Command { get; set; } = default!;

    [Parameter] public object? CommandParameter { get; set; }

    /// <summary>False disables the item whatever the command says (e.g. a one-file action in a menu for several files).</summary>
    [Parameter] public bool Enabled { get; set; } = true;

    [Parameter] public string? Title { get; set; }

    private async Task Execute()
    {
        await Task.Yield(); // see ObservingComponentBase.Run
        if (Enabled && Command.CanExecute(CommandParameter))
        {
            Command.Execute(CommandParameter);
        }
    }
}
