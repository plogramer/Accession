<button class="menu-item" role="menuitem" disabled="@(!Command.CanExecute(CommandParameter))" @onclick="Execute">
    <Icon Name="@Icon" Size="16" />
    <span>@Text</span>
</button>

@code {
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    [Parameter, EditorRequired] public ICommand Command { get; set; } = default!;

    [Parameter] public object? CommandParameter { get; set; }

    private async Task Execute()
    {
        await Task.Yield(); // see ObservingComponentBase.Run
        if (Command.CanExecute(CommandParameter))
        {
            Command.Execute(CommandParameter);
        }
    }
}
