<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- A Windows version is needed: the web view's WebView2 control uses the Windows SDK projection
         (Microsoft.Windows.SDK.NET), which is only included for versioned Windows targets. 17763 = Windows 10 1809. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AssemblyName>Accession</AssemblyName>
    <RootNamespace>Accession.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Made by tools/icon/make_icon.py from the brand mark (Assets/Accession.svg). -->
    <ApplicationIcon>Assets\Accession.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Accession.Core\Accession.Core.csproj" />
    <ProjectReference Include="..\Accession.Data\Accession.Data.csproj" />
    <ProjectReference Include="..\Accession.Presentation\Accession.Presentation.csproj" />
    <ProjectReference Include="..\Accession.UI\Accession.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\Accession.ico" />
  </ItemGroup>

</Project>
