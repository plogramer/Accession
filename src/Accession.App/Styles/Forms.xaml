<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Accession.App.Converters">
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />

    <!-- Label column text in forms. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,4,12,4" />
    </Style>

    <!-- Secondary text (hints, info). -->
    <Style x:Key="HintText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Validation message under a field; collapses when empty. -->
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#C42B1C" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="FormTextBox" TargetType="TextBox">
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="Padding" Value="2,3" />
    </Style>

    <Style x:Key="DialogButton" TargetType="Button">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style x:Key="ReadOnlyValue" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0,4" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
