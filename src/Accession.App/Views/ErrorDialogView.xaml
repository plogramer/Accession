<UserControl x:Class="Accession.App.Views.ErrorDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxWidth="720">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" MinWidth="110" Margin="0,0,8,0" />
            <Button Content="Copy details" Command="{Binding CopyDetailsCommand}" MinWidth="90" Margin="0,0,8,0" />
            <Button Content="OK" Command="{Binding OkCommand}" MinWidth="80" IsDefault="True" IsCancel="True" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontWeight="SemiBold" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}">
                <Run Text="Details were written to the application log:" />
                <Run Text="{Binding LogFolder, Mode=OneWay}" />
            </TextBlock>
            <Expander Header="Technical details" Margin="0,12,0,0">
                <Expander.Style>
                    <Style TargetType="Expander">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDetails}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Expander.Style>
                <TextBox Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                         TextWrapping="NoWrap" MaxHeight="300" Margin="0,6,0,0"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
            </Expander>
        </StackPanel>
    </DockPanel>
</UserControl>
