<UserControl x:Class="Accession.App.Views.ScanQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="16">
        <!-- Header with controls -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="⏸ Pause" Command="{Binding PauseCommand}" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="⏵ Resume" Command="{Binding ResumeCommand}" Padding="10,4" Margin="0,0,6,0" />
                <Button Content="⏹ Cancel" Command="{Binding CancelCommand}" Padding="10,4" />
            </StackPanel>
            <TextBlock Text="Scan Queue" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Queue -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Queue" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock DockPanel.Dock="Top" Text="Nothing waiting." Style="{StaticResource HintText}"
                       Visibility="{Binding HasQueue, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}" />
            <ListBox ItemsSource="{Binding Queue}" MaxHeight="220" HorizontalContentAlignment="Stretch"
                     Visibility="{Binding HasQueue, Converter={StaticResource BoolToVisibility}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="2">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="↑" Width="28" Margin="2,0" ToolTip="Move up"
                                        Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                <Button Content="↓" Width="28" Margin="2,0" ToolTip="Move down"
                                        Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                <Button Content="✕" Width="28" Margin="2,0" ToolTip="Remove from queue"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                            </StackPanel>
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="{Binding Position, Mode=OneWay, StringFormat={}{0}.}" />
                                <Run Text="{Binding MediaId, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding Type, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                            </TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Current scan -->
        <Grid>
            <TextBlock Text="{Binding IdleText}" Style="{StaticResource HintText}"
                       Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisibility}}" />
            <Border Padding="16" BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}"
                    Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock FontSize="16">
                        <Run Text="Now scanning:" />
                        <Run Text="{Binding CurrentMedia, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>
                    <TextBlock Text="{Binding Phase}" Margin="0,4,0,0" Style="{StaticResource HintText}" />
                    <TextBlock Text="{Binding Counts}" Margin="0,10,0,0" />
                    <ProgressBar Height="14" Margin="0,10,0,0" Maximum="100" Value="{Binding Percent, Mode=OneWay}"
                                 IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Hashed" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Column="1" Text="{Binding HashedText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="Data" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Column="3" Text="{Binding BytesText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="Throughput" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding RateText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Errors" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding Errors}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="Elapsed" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Elapsed}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="ETA" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding Eta}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Text="Threads" Style="{StaticResource FieldLabel}" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Threads}" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="Current item" Margin="0,10,0,0" Style="{StaticResource HintText}" />
                    <TextBlock Text="{Binding CurrentPath}" TextTrimming="CharacterEllipsis" FontFamily="Consolas" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
