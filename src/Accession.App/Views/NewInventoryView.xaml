<UserControl x:Class="Accession.App.Views.NewInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="640">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Create" Command="{Binding CreateCommand}" IsDefault="True" Style="{StaticResource DialogButton}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- 0 client name -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /> <!-- 2 client id -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /> <!-- 4 matter name -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /> <!-- 6 matter id -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /> <!-- 8 description -->
                <RowDefinition Height="Auto" /> <!-- 9 matter link -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /> <!-- 11 separator -->
                <RowDefinition Height="Auto" /> <!-- 12 root -->
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" /> <!-- 14 save as -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Client Name *" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FormTextBox}"
                     Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}" Text="{Binding Errors[ClientName]}" />

            <TextBlock Grid.Row="2" Text="Client ID *" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FormTextBox}"
                     Text="{Binding ClientCode, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}" Text="{Binding Errors[ClientCode]}" />

            <TextBlock Grid.Row="4" Text="Matter Name *" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FormTextBox}"
                     Text="{Binding MatterName, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}" Text="{Binding Errors[MatterName]}" />

            <TextBlock Grid.Row="6" Text="Matter ID *" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FormTextBox}"
                     Text="{Binding MatterCode, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}" Text="{Binding Errors[MatterCode]}" />

            <TextBlock Grid.Row="8" Text="Description" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,4" />
            <TextBox Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FormTextBox}"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" TextWrapping="Wrap" Height="56" VerticalScrollBarVisibility="Auto" />

            <TextBlock Grid.Row="9" Text="Matter Link" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="9" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FormTextBox}"
                     Text="{Binding MatterUrl, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Optional link to the matter in your project management system (http:// or https://)" />
            <TextBlock Grid.Row="10" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}" Text="{Binding Errors[MatterUrl]}" />

            <Separator Grid.Row="11" Grid.ColumnSpan="3" Margin="0,8" />

            <TextBlock Grid.Row="12" Text="Root Folder *" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="12" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding RootFolder}"
                     ToolTip="The parent folder that directly contains all media folders" />
            <Button Grid.Row="12" Grid.Column="2" Content="…" Command="{Binding BrowseRootFolderCommand}" Width="32" Margin="6,4,0,4" />
            <StackPanel Grid.Row="13" Grid.Column="1" Grid.ColumnSpan="2">
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding Errors[RootFolder]}" />
                <TextBlock Style="{StaticResource HintText}" Text="{Binding RootInfo}" Margin="0,0,0,4" />
            </StackPanel>

            <TextBlock Grid.Row="14" Text="Save As *" Style="{StaticResource FieldLabel}" />
            <TextBox Grid.Row="14" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding SavePath}" />
            <Button Grid.Row="14" Grid.Column="2" Content="…" Command="{Binding BrowseSavePathCommand}" Width="32" Margin="6,4,0,4" />
            <TextBlock Grid.Row="15" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource ErrorText}" Text="{Binding Errors[SavePath]}" />
        </Grid>
    </DockPanel>
</UserControl>
