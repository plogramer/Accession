<UserControl x:Class="Accession.App.Views.FileBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="8">
        <!-- Filter bar -->
        <Border DockPanel.Dock="Top" Padding="4" Margin="0,0,0,6">
            <StackPanel>
                <WrapPanel>
                    <TextBlock Text="Media" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding MediaOptions}" SelectedItem="{Binding SelectedMedia}" DisplayMemberPath="Label" MinWidth="130" Margin="0,2,12,2" />
                    <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Label" MinWidth="150" Margin="0,2,12,2" />
                    <TextBlock Text="Ext" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding ExtensionText, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,2,12,2" ToolTip="e.g. msg; '(none)' for files without extension" />
                    <TextBlock Text="{Binding SizeUnitLabel, StringFormat=Size ({0})}" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding MinSizeText, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,2,2,2" ToolTip="Minimum size" />
                    <TextBlock Text="–" VerticalAlignment="Center" />
                    <TextBox Text="{Binding MaxSizeText, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="2,2,12,2" ToolTip="Maximum size" />
                    <TextBlock Text="Modified (UTC)" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding ModifiedFrom}" Width="115" Margin="0,2,2,2" />
                    <TextBlock Text="–" VerticalAlignment="Center" />
                    <DatePicker SelectedDate="{Binding ModifiedTo}" Width="115" Margin="2,2,12,2" />
                </WrapPanel>
                <WrapPanel>
                    <TextBlock Text="Name contains" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding NameContains, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,2,12,2" />
                    <TextBlock Text="SHA-1" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox Text="{Binding Sha1Text, UpdateSourceTrigger=PropertyChanged}" Width="200" Margin="0,2,12,2" FontFamily="Consolas" />
                    <TextBlock Text="Hash" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox ItemsSource="{Binding HashStatusOptions}" SelectedItem="{Binding SelectedHashStatus}" DisplayMemberPath="Label" MinWidth="120" Margin="0,2,12,2" />
                    <CheckBox Content="Include subfolders" IsChecked="{Binding IncludeSubfolders}" VerticalAlignment="Center" Margin="0,2,12,2" />
                    <CheckBox Content="Duplicates only" IsChecked="{Binding DuplicatesOnly}" VerticalAlignment="Center" Margin="0,2,12,2" />
                    <CheckBox Content="Errors only" IsChecked="{Binding ErrorsOnly}" VerticalAlignment="Center" Margin="0,2,12,2" />
                    <Button Content="Apply" Command="{Binding ApplyCommand}" IsDefault="True" Padding="10,2" Margin="0,2,6,2" />
                    <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Padding="10,2" Margin="0,2,6,2" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,2" Margin="0,2,6,2" />
                    <Button Content="Export current view" IsEnabled="False" Padding="10,2" Margin="0,2,0,2" ToolTip="Available with Excel export" />
                </WrapPanel>
                <TextBlock Text="{Binding FilterError}" Style="{StaticResource ErrorText}" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Load more" Command="{Binding LoadMoreCommand}" Padding="8,2"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding TotalsText}" VerticalAlignment="Center" />
        </DockPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="120" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Folder tree -->
            <TreeView x:Name="FolderTree" ItemsSource="{Binding Folders}" SelectedItemChanged="FolderTree_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <!-- Files -->
            <DataGrid x:Name="FileGrid" Grid.Column="2" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" CanUserAddRows="False" EnableRowVirtualization="True"
                      EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      Sorting="FileGrid_Sorting" Loaded="FileGrid_Loaded">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy full path" Command="{Binding CopyPathCommand}" />
                        <MenuItem Header="Copy SHA-1" Command="{Binding CopySha1Command}" />
                        <MenuItem Header="Show duplicates" Command="{Binding ShowDuplicatesCommand}" />
                        <Separator />
                        <MenuItem Header="Open containing folder" Command="{Binding OpenContainingFolderCommand}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Media ID" Binding="{Binding MediaId}" SortMemberPath="Default" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" SortMemberPath="Name" />
                    <DataGridTextColumn Header="Ext" Binding="{Binding Extension}" SortMemberPath="Extension" />
                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" CanUserSort="False" />
                    <DataGridTextColumn Header="Folder" Binding="{Binding FolderPath}" Width="2*" SortMemberPath="Default" />
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="Size" />
                    <DataGridTextColumn Header="Created" Binding="{Binding Created}" CanUserSort="False" />
                    <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" SortMemberPath="Modified" />
                    <DataGridTextColumn Header="Accessed" Binding="{Binding Accessed}" CanUserSort="False" />
                    <DataGridTextColumn Header="SHA-1" Binding="{Binding Sha1}" CanUserSort="False" FontFamily="Consolas" />
                    <DataGridTextColumn Header="Hash" Binding="{Binding HashStatus}" CanUserSort="False" />
                    <DataGridTextColumn Header="Dups" Binding="{Binding Duplicates}" CanUserSort="False" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</UserControl>
