<UserControl x:Class="Accession.App.Views.WebAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0F1422">
    <!-- The BlazorWebView is created in code once the view model is known (it is a root component parameter).
         A Grid (not a ContentControl) so the web view stretches: WebView2 has no size of its own. -->
    <Grid x:Name="Host" />
</UserControl>
