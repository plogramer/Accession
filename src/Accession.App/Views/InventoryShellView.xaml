<UserControl x:Class="Accession.App.Views.InventoryShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding RootPath, StringFormat=Root: {0}}" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem Visibility="{Binding IsOffline, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Root folder unavailable (offline)" Foreground="#C42B1C" FontWeight="SemiBold" />
            </StatusBarItem>
            <StatusBarItem>
                <TextBlock Text="{Binding LockStatus}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="{Binding SchemaText}" />
            </StatusBarItem>
        </StatusBar>

        <!-- Left navigation -->
        <Border DockPanel.Dock="Left" Width="190" BorderThickness="0,0,1,0"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedItem}" BorderThickness="0"
                     HorizontalContentAlignment="Stretch" Padding="0,8">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="8,6">
                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="6,0" Background="#E5E5E5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Badge}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Badge}" FontSize="11" />
                            </Border>
                            <TextBlock Text="{Binding Title}" FontSize="14" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Notice banner (e.g. media not scanned yet) -->
        <Border DockPanel.Dock="Top" Background="#FFF4CE" BorderBrush="#E8D48A" BorderThickness="0,0,0,1" Padding="12,6"
                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Dismiss" Command="{Binding DismissNoticeCommand}" Padding="8,2" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Content="Show media" Command="{Binding ShowMediaCommand}" Padding="8,2" Margin="8,0,0,0" />
                <TextBlock Text="{Binding Notice}" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="#3B3000" />
            </DockPanel>
        </Border>

        <!-- Selected screen -->
        <ContentControl Content="{Binding SelectedItem.Content}" Focusable="False" />
    </DockPanel>
</UserControl>
