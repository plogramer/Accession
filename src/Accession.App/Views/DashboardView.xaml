<UserControl x:Class="Accession.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Tile" TargetType="Border">
            <Setter Property="Width" Value="150" />
            <Setter Property="MinHeight" Value="78" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" />
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" />
        </Style>
        <Style x:Key="TileLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
        </Style>
        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <DataTemplate x:Key="BarTemplate">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <Rectangle Grid.Column="1" Height="14" HorizontalAlignment="Left" Width="{Binding BarLength}" Fill="#4F7FC6" RadiusX="2" RadiusY="2" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Run Text="{Binding Size, Mode=OneWay}" />
                    <Run Text="·" />
                    <Run Text="{Binding Files, Mode=OneWay}" />
                    <Run Text="files" />
                    <Run Text="{Binding PercentSize, Mode=OneWay}" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
            <!-- Header -->
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Media:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Grid>
                        <ToggleButton x:Name="FilterButton" IsChecked="{Binding IsFilterOpen}" MinWidth="170" Padding="8,3" HorizontalContentAlignment="Left">
                            <TextBlock Text="{Binding FilterText, StringFormat={}{0}  ▾}" />
                        </ToggleButton>
                        <Popup IsOpen="{Binding IsFilterOpen}" PlacementTarget="{Binding ElementName=FilterButton}" StaysOpen="False" AllowsTransparency="True">
                            <Border Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}" BorderThickness="1" Padding="8"
                                    BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}" MinWidth="220">
                                <StackPanel>
                                    <Button Content="Select all media" Command="{Binding SelectAllMediaCommand}" HorizontalAlignment="Left" Padding="6,2" Margin="0,0,0,6" />
                                    <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding MediaFilter}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding MediaId}" IsChecked="{Binding IsChecked}" Margin="0,2" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Content="⟳ Refresh" Command="{Binding RefreshCommand}" Padding="8,3" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="Dashboard" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>

            <!-- Banners -->
            <Border Background="#FFF4CE" Padding="10,6" Margin="0,10,0,0" Visibility="{Binding ScanInProgress, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Scan in progress – figures may be incomplete. Duplicates, By Year and Largest Files load when the scan finishes." TextWrapping="Wrap" />
            </Border>
            <TextBlock Text="{Binding LoadError}" Style="{StaticResource ErrorText}" Margin="0,8,0,0" />
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,8,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

            <!-- Tiles -->
            <WrapPanel Margin="0,12,0,0">
                <Border Style="{StaticResource Tile}">
                    <StackPanel><TextBlock Text="Media" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding MediaCount}" Style="{StaticResource TileValue}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel><TextBlock Text="Folders" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding FolderCount}" Style="{StaticResource TileValue}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel><TextBlock Text="Files" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding FileCount}" Style="{StaticResource TileValue}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel><TextBlock Text="Size" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding TotalSize}" Style="{StaticResource TileValue}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel><TextBlock Text="Hashed" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding HashedPercent}" Style="{StaticResource TileValue}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel><TextBlock Text="Unique files" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding UniqueFiles}" Style="{StaticResource TileValue}" /></StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}" Width="190" Cursor="Hand" MouseLeftButtonUp="Duplicates_Click" ToolTip="Click to show duplicate files">
                    <StackPanel>
                        <TextBlock Text="Duplicates" Style="{StaticResource TileLabel}" />
                        <TextBlock Style="{StaticResource TileValue}">
                            <Run Text="{Binding DuplicateFiles, Mode=OneWay}" />
                            <Run Text="{Binding DuplicateSize, Mode=OneWay}" FontSize="13" FontWeight="Normal" />
                        </TextBlock>
                        <TextBlock Text="{Binding DuplicateNote}" Style="{StaticResource HintText}" FontSize="11" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Tile}">
                    <StackPanel><TextBlock Text="Errors" Style="{StaticResource TileLabel}" /><TextBlock Text="{Binding ErrorCount}" Style="{StaticResource TileValue}" /></StackPanel>
                </Border>
            </WrapPanel>

            <!-- By Media -->
            <TextBlock Text="By Media" Style="{StaticResource SectionTitle}" />
            <DataGrid ItemsSource="{Binding ByMedia}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="300"
                      MouseDoubleClick="ByMedia_DoubleClick" ToolTip="Double-click to show the files"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Media ID" Binding="{Binding MediaId}" Width="2*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="1.3*" />
                    <DataGridTextColumn Header="Folders" Binding="{Binding Folders}" />
                    <DataGridTextColumn Header="Files" Binding="{Binding Files}" SortMemberPath="FileCount" />
                    <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="TotalBytes" />
                    <DataGridTextColumn Header="Hashed" Binding="{Binding Hashed}" />
                    <DataGridTextColumn Header="Duplicates" Binding="{Binding Duplicates}" />
                    <DataGridTextColumn Header="Errors" Binding="{Binding Errors}" />
                    <DataGridTextColumn Header="Scans" Binding="{Binding Scans}" />
                    <DataGridTextColumn Header="Last Scanned" Binding="{Binding LastScanned}" Width="1.5*" />
                </DataGrid.Columns>
            </DataGrid>

            <!-- By Category / By Extension -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="By Category (by size)" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding ByCategory}" SelectedItem="{Binding SelectedCategory}" ItemTemplate="{StaticResource BarTemplate}"
                             BorderThickness="0" ToolTip="Select a category to show its extensions; double-click to show its files"
                             MouseDoubleClick="ByCategory_DoubleClick" />
                    <Button Content="Show all extensions" Command="{Binding ClearCategoryCommand}" HorizontalAlignment="Left" Padding="6,2" Margin="0,6,0,0" />
                </StackPanel>
                <DockPanel Grid.Column="1">
                    <DockPanel DockPanel.Dock="Top">
                        <TextBox DockPanel.Dock="Right" Width="160" Margin="0,16,0,6" VerticalAlignment="Bottom"
                                 Text="{Binding ExtensionSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search extensions" />
                        <TextBlock Text="{Binding ExtensionHeader}" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <DataGrid ItemsSource="{Binding ByExtension}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="380"
                              MouseDoubleClick="ByExtension_DoubleClick" ToolTip="Double-click to show the files"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Extension" Binding="{Binding Extension}" />
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*" />
                            <DataGridTextColumn Header="Files" Binding="{Binding Files}" SortMemberPath="FileCount" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="TotalBytes" />
                            <DataGridTextColumn Header="% Size" Binding="{Binding PercentSize}" SortMemberPath="TotalBytes" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Grid>

            <!-- By Year / Largest Files -->
            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,16,0,0" Visibility="{Binding IsLoadingDetails, Converter={StaticResource BoolToVisibility}}" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,24,0">
                    <TextBlock Text="By Year (modified, UTC)" Style="{StaticResource SectionTitle}" />
                    <ListBox ItemsSource="{Binding ByYear}" ItemTemplate="{StaticResource BarTemplate}" BorderThickness="0"
                             MouseDoubleClick="ByYear_DoubleClick" ToolTip="Double-click to show the files of that year" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Largest Files (top 100)" Style="{StaticResource SectionTitle}" />
                    <DataGrid ItemsSource="{Binding LargestFiles}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="380"
                              MouseDoubleClick="LargestFiles_DoubleClick" ToolTip="Double-click to show the file"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Media ID" Binding="{Binding MediaId}" />
                            <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" SortMemberPath="SizeBytes" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
