<UserControl x:Class="Accession.App.Views.InventoryPropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="600">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="Opened read-only: changes are not possible." Style="{StaticResource HintText}" VerticalAlignment="Center"
                       Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True" Style="{StaticResource DialogButton}"
                        Visibility="{Binding CanEdit, Converter={StaticResource BoolToVisibility}}" />
                <Button Content="Close" Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource DialogButton}" />
            </StackPanel>
        </DockPanel>

        <TabControl MinHeight="330">
            <TabItem Header="Matter">
                <Grid Margin="12" IsEnabled="{Binding CanEdit}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Client Name *" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding ClientName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ErrorText}" Text="{Binding Errors[ClientName]}" />

                    <TextBlock Grid.Row="2" Text="Client ID *" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding ClientCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ErrorText}" Text="{Binding Errors[ClientCode]}" />

                    <TextBlock Grid.Row="4" Text="Matter Name *" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding MatterName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource ErrorText}" Text="{Binding Errors[MatterName]}" />

                    <TextBlock Grid.Row="6" Text="Matter ID *" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding MatterCode, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Style="{StaticResource ErrorText}" Text="{Binding Errors[MatterCode]}" />

                    <TextBlock Grid.Row="8" Text="Description" Style="{StaticResource FieldLabel}" VerticalAlignment="Top" Margin="0,8,12,4" />
                    <TextBox Grid.Row="8" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="56" VerticalScrollBarVisibility="Auto" />

                    <TextBlock Grid.Row="9" Text="Matter Link" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="9" Grid.Column="1" Style="{StaticResource FormTextBox}" Text="{Binding MatterUrl, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Row="10" Grid.Column="1" Style="{StaticResource ErrorText}" Text="{Binding Errors[MatterUrl]}" />
                </Grid>
            </TabItem>

            <TabItem Header="Location">
                <StackPanel Margin="12">
                    <TextBlock Text="Root folder" Style="{StaticResource HintText}" />
                    <TextBox Text="{Binding RootPath, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" />
                    <TextBlock Text="{Binding RootStatus}" Margin="0,0,0,8" />
                    <Button Content="Change Root Path…" Command="{Binding ChangeRootPathCommand}" HorizontalAlignment="Left" Padding="10,4"
                            IsEnabled="{Binding CanEdit}" />
                    <TextBlock Text="Inventory file" Margin="0,16,0,0" Style="{StaticResource HintText}" />
                    <TextBox Text="{Binding DbPath, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Info">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Inventory ID" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Column="1" Text="{Binding InventoryGuid, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" />
                    <TextBlock Grid.Row="1" Text="Schema version" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SchemaVersion, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" />
                    <TextBlock Grid.Row="2" Text="Created by" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CreatedBy, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" />
                    <TextBlock Grid.Row="3" Text="Created" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CreatedAt, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" />
                    <TextBlock Grid.Row="4" Text="Created with version" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CreatedAppVersion, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" />
                    <TextBlock Grid.Row="5" Text="Lock holder" Style="{StaticResource FieldLabel}" />
                    <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding LockHolder, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" />
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
