<UserControl x:Class="Accession.App.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,4,0" />
            <DatePicker SelectedDate="{Binding FromDate}" Width="120" Margin="0,2,10,2" />
            <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,4,0" />
            <DatePicker SelectedDate="{Binding ToDate}" Width="120" Margin="0,2,10,2" />
            <TextBlock Text="Action" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding ActionOptions}" SelectedItem="{Binding SelectedAction}" DisplayMemberPath="Label" MinWidth="160" Margin="0,2,10,2" />
            <TextBlock Text="User" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox ItemsSource="{Binding UserOptions}" SelectedItem="{Binding SelectedUser}" DisplayMemberPath="Label" MinWidth="150" Margin="0,2,10,2" />
            <TextBlock Text="Media ID" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Text="{Binding MediaIdText, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,2,4,2">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ApplyMediaFilterCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <Button Content="Apply" Command="{Binding ApplyMediaFilterCommand}" Padding="8,2" Margin="0,2,10,2" />
            <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Padding="8,2" Margin="0,2,6,2" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="8,2" Margin="0,2,6,2" />
            <Button Content="Export" IsEnabled="False" Padding="8,2" Margin="0,2,0,2" ToolTip="Available with Excel export" />
        </WrapPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Load more" Command="{Binding LoadMoreCommand}" Padding="8,2"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="The audit log is read-only. Entries are never changed or deleted." Style="{StaticResource HintText}" VerticalAlignment="Center" />
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="160" MinHeight="60" />
            </Grid.RowDefinitions>
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                      EnableRowVirtualization="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" />
                    <DataGridTextColumn Header="User" Binding="{Binding User}" />
                    <DataGridTextColumn Header="Machine" Binding="{Binding Machine}" />
                    <DataGridTextColumn Header="Action" Binding="{Binding Action}" />
                    <DataGridTextColumn Header="Media ID" Binding="{Binding MediaId}" />
                    <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="*" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
            <TextBox Grid.Row="2" Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Grid>
    </DockPanel>
</UserControl>
