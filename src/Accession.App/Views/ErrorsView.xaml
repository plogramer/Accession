<UserControl x:Class="Accession.App.Views.ErrorsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="12">
        <!-- Filters and actions -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Media" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding MediaOptions}" SelectedItem="{Binding SelectedMedia}" DisplayMemberPath="Label" MinWidth="160" Margin="0,0,16,0" />
            <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox ItemsSource="{Binding ErrorTypeOptions}" SelectedItem="{Binding SelectedErrorType}" DisplayMemberPath="Label" MinWidth="160" Margin="0,0,16,0" />
            <CheckBox Content="Show info entries" IsChecked="{Binding ShowInfo}" VerticalAlignment="Center" Margin="0,0,16,0"
                      ToolTip="Info entries are not errors, e.g. junctions and symbolic links that were recorded but not followed" />
            <Button Content="Retry Failed Files" Command="{Binding RetryFailedCommand}" Padding="8,3" Margin="0,0,6,0"
                    ToolTip="Hash again the files of the selected media that could not be read" />
            <Button Content="Copy Path" Command="{Binding CopyPathCommand}" Padding="8,3" Margin="0,0,6,0" />
            <Button Content="Export" IsEnabled="False" Padding="8,3" Margin="0,0,6,0" ToolTip="Available with Excel export" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="8,3" />
        </WrapPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Load more" Command="{Binding LoadMoreCommand}" Padding="8,3"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource HintText}" VerticalAlignment="Center" />
        </DockPanel>

        <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                  EnableRowVirtualization="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" />
                <DataGridTextColumn Header="Media ID" Binding="{Binding MediaId}" />
                <DataGridTextColumn Header="Relative Path" Binding="{Binding RelativePath}" Width="3*" />
                <DataGridTextColumn Header="Item" Binding="{Binding ItemType}" />
                <DataGridTextColumn Header="Error Type" Binding="{Binding ErrorType}" />
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" />
                <DataGridTextColumn Header="Code" Binding="{Binding Code}" />
                <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="3*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
