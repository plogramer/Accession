<UserControl x:Class="Accession.App.Views.ChangeRootPathView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Change" Command="{Binding ApplyCommand}" IsDefault="True" Style="{StaticResource DialogButton}" />
            <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" Style="{StaticResource DialogButton}" />
        </StackPanel>
        <StackPanel>
            <TextBlock Text="Current root folder" Style="{StaticResource HintText}" />
            <TextBox Text="{Binding CurrentRootPath, Mode=OneWay}" Style="{StaticResource ReadOnlyValue}" />

            <TextBlock Text="New root folder" Margin="0,12,0,0" Style="{StaticResource HintText}" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding BrowseCommand}" MinWidth="80" Margin="8,4,0,4" />
                <TextBox Text="{Binding NewRootPath}" Style="{StaticResource FormTextBox}" />
            </DockPanel>

            <TextBlock Text="{Binding PreviewText}" Margin="0,8,0,0" TextWrapping="Wrap" />
            <ListBox ItemsSource="{Binding MediaNotFound}" MaxHeight="160" Margin="0,4,0,0"
                     Visibility="{Binding HasMediaNotFound, Converter={StaticResource BoolToVisibility}}" />

            <TextBlock Margin="0,12,0,0" Style="{StaticResource HintText}"
                       Text="All paths in the inventory are stored relative to the root folder, so no rescan is needed after moving the inventory and its media." />
        </StackPanel>
    </DockPanel>
</UserControl>
