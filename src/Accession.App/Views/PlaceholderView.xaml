<UserControl x:Class="Accession.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="32">
        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
        <TextBlock Text="{Binding Description}" Margin="0,8,0,0" Style="{StaticResource HintText}" />
        <TextBlock Text="{Binding PlannedIn, StringFormat=This screen is not built yet. Planned in: {0}.}" Margin="0,16,0,0"
                   Style="{StaticResource HintText}" />
    </StackPanel>
</UserControl>
