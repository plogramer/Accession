<UserControl x:Class="Accession.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560">
    <UserControl.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="8" />
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="NumberBox" TargetType="TextBox">
            <Setter Property="Width" Value="90" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
            <Button Content="Restore defaults" Command="{Binding RestoreDefaultsCommand}" MinWidth="110" DockPanel.Dock="Left" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Command="{Binding OkCommand}" IsDefault="True" MinWidth="80" Margin="0,0,8,0" />
                <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True" MinWidth="80" />
            </StackPanel>
        </DockPanel>

        <StackPanel>
            <GroupBox Header="Display">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Label Content="_Size units" Target="{Binding ElementName=SizeUnitBox}" />
                    <ComboBox x:Name="SizeUnitBox" Grid.Column="1" Margin="0,3"
                              ItemsSource="{Binding SizeUnitOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding SizeUnit}" />
                    <Label Grid.Row="1" Content="_Time zone" Target="{Binding ElementName=TimeZoneBox}" />
                    <ComboBox x:Name="TimeZoneBox" Grid.Row="1" Grid.Column="1" Margin="0,3"
                              ItemsSource="{Binding TimeZoneOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                              SelectedValue="{Binding DisplayTimeZone}" />
                </Grid>
            </GroupBox>

            <GroupBox Header="Scanning">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Label Content="_Enumeration threads" Target="{Binding ElementName=EnumBox}" />
                        <TextBox x:Name="EnumBox" Grid.Column="1" Style="{StaticResource NumberBox}"
                                 Text="{Binding EnumerationThreads, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource HintText}" Text="{Binding EnumerationThreadsRange}" />
                        <Label Grid.Row="1" Content="_Hashing threads" Target="{Binding ElementName=HashBox}" />
                        <TextBox x:Name="HashBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource NumberBox}"
                                 Text="{Binding HashingThreads, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource HintText}" Text="{Binding HashingThreadsRange}" />
                    </Grid>
                    <Expander Header="Advanced" Margin="0,6,0,0">
                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label Content="_Database batch size" Target="{Binding ElementName=BatchBox}" />
                            <TextBox x:Name="BatchBox" Grid.Column="1" Style="{StaticResource NumberBox}"
                                     Text="{Binding DbBatchSize, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2" Style="{StaticResource HintText}"
                                       Text="{Binding DbBatchSizeRange, StringFormat={}{0} rows per commit}" />
                        </Grid>
                    </Expander>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Export">
                <StackPanel>
                    <Label Content="_Default export folder" Target="{Binding ElementName=ExportFolderBox}" Padding="0,0,0,4" />
                    <DockPanel>
                        <Button Content="Browse…" Command="{Binding BrowseExportFolderCommand}" DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" />
                        <TextBox x:Name="ExportFolderBox" Text="{Binding DefaultExportFolder, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" TextWrapping="Wrap"
                               Text="{Binding DocumentsFolder, StringFormat=Leave empty to use {0}}" />
                    <CheckBox Content="Create one _workbook per media" IsChecked="{Binding SplitExportPerMedia}" Margin="0,10,0,0" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </DockPanel>
</UserControl>
