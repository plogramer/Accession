<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Accession.App.ViewModels"
                    xmlns:shell="clr-namespace:Accession.App.ViewModels.Shell"
                    xmlns:views="clr-namespace:Accession.App.Views">
    <!-- Maps each view model to its view. The navigation and dialog services rely on these. -->

    <!-- Screens -->
    <DataTemplate DataType="{x:Type vm:StartViewModel}">
        <views:StartView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type shell:InventoryShellViewModel}">
        <views:InventoryShellView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type shell:PlaceholderViewModel}">
        <views:PlaceholderView />
    </DataTemplate>

    <!-- Dialogs -->
    <DataTemplate DataType="{x:Type vm:NewInventoryViewModel}">
        <views:NewInventoryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LockConflictViewModel}">
        <views:LockConflictView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:RootUnreachableViewModel}">
        <views:RootUnreachableView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ChangeRootPathViewModel}">
        <views:ChangeRootPathView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:InventoryPropertiesViewModel}">
        <views:InventoryPropertiesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ErrorDialogViewModel}">
        <views:ErrorDialogView />
    </DataTemplate>
</ResourceDictionary>
