<Window x:Class="Accession.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Accession.App.Views"
        Title="{Binding Title}"
        Width="1200" Height="800" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <!-- The whole UI is the web page; its DataContext is set in code (WebAppViewModel). -->
    <views:WebAppView x:Name="Page" />
</Window>
